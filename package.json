{
  "name": "transmission-electron-gui",
  "version": "0.1.0",
  "description": "A modern Electron desktop GUI for Transmission daemon RPC.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "homepage": "https://github.com/adameat/transmission-electron-gui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/adameat/transmission-electron-gui.git"
  },
  "bugs": {
    "url": "https://github.com/adameat/transmission-electron-gui/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "io.github.adameat.transmission-electron-gui",
    "productName": "Transmission Electron GUI",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
